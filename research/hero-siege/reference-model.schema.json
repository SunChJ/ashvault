{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://samsoncj.com/schemas/ashvault/reference-catalog.schema.json",
  "title": "Ashvault External Reference Catalog",
  "type": "object",
  "required": ["schema_version", "snapshot_id", "entities"],
  "properties": {
    "schema_version": { "const": 1 },
    "snapshot_id": { "type": "string", "minLength": 1 },
    "entities": {
      "type": "array",
      "items": { "$ref": "#/$defs/referenceEntity" }
    }
  },
  "$defs": {
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "source_url", "observed_at"],
      "properties": {
        "source_id": { "type": "string", "minLength": 1 },
        "external_id": { "type": ["string", "null"] },
        "source_url": { "type": "string", "format": "uri" },
        "observed_at": { "type": "string", "format": "date-time" },
        "artifact_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "referenceEntity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference_id", "kind", "name", "source_refs", "facets"],
      "properties": {
        "reference_id": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": [
            "item",
            "item_base",
            "affix",
            "stat",
            "skill",
            "tree_node",
            "build",
            "zone",
            "boss",
            "dungeon",
            "season_mechanic"
          ]
        },
        "name": { "type": "string", "minLength": 1 },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sourceRef" }
        },
        "facets": { "type": "object" },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}

