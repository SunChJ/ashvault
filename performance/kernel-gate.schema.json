{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SunChJ/ashvault/blob/main/performance/kernel-gate.schema.json",
  "title": "Ashvault M1 Kernel Gate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "gate_id", "runtime", "replay", "thresholds", "reference_capture"],
  "properties": {
    "schema_version": {"const": 1},
    "gate_id": {"const": "m1.kernel.v1"},
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["godot_version", "simulation_version", "content_version", "fixed_ticks_per_second"],
      "properties": {
        "godot_version": {"const": "4.7.2"},
        "simulation_version": {"type": "integer", "minimum": 1},
        "content_version": {"type": "integer", "minimum": 1},
        "fixed_ticks_per_second": {"const": 60}
      }
    },
    "replay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["benchmark_id", "build_id", "encounter_id", "root_seed", "duration_ticks", "command_count", "expected_state_hash", "expected_report_hash"],
      "properties": {
        "benchmark_id": {"const": "combat.headless.v1"},
        "build_id": {"type": "string", "minLength": 1},
        "encounter_id": {"type": "string", "minLength": 1},
        "root_seed": {"type": "string", "pattern": "^-?(0|[1-9][0-9]*)$"},
        "duration_ticks": {"type": "integer", "minimum": 1},
        "command_count": {"type": "integer", "minimum": 0},
        "expected_state_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "expected_report_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["portable_tick_p95_usec", "apple_m1_pro_tick_p95_usec", "max_event_depth", "peak_entity_count"],
      "properties": {
        "portable_tick_p95_usec": {"type": "integer", "minimum": 1},
        "apple_m1_pro_tick_p95_usec": {"type": "integer", "minimum": 1},
        "max_event_depth": {"type": "integer", "minimum": 0},
        "peak_entity_count": {"type": "integer", "minimum": 1}
      }
    },
    "reference_capture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "report_path", "platform", "processor", "model"],
      "properties": {
        "profile_id": {"const": "apple.m1_pro.16gb"},
        "report_path": {"type": "string", "minLength": 1},
        "platform": {"const": "macOS"},
        "processor": {"const": "Apple M1 Pro"},
        "model": {"const": "MacBookPro18,3"}
      }
    }
  }
}
