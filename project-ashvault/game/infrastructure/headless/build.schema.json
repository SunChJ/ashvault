{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ashvault Build V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "build_id",
    "skills",
    "rotation",
    "duration_ticks",
    "root_seed",
    "loadout",
    "conditions",
    "objective",
    "base_stats"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "build_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
    },
    "skills": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "arc_bolt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "chain_lightning": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "thunder_nova": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "static_ward": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "storm_totem": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "tempest_dash": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        }
      }
    },
    "rotation": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tick",
          "skill"
        ],
        "properties": {
          "tick": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3600
          },
          "skill": {
            "enum": [
              "arc_bolt",
              "chain_lightning",
              "thunder_nova",
              "static_ward",
              "storm_totem",
              "tempest_dash"
            ]
          }
        }
      }
    },
    "duration_ticks": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3600
    },
    "root_seed": {
      "type": "integer",
      "minimum": -2147483648,
      "maximum": 2147483647
    },
    "loadout": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "slot.weapon": {
          "$ref": "#/$defs/selector"
        },
        "slot.off_hand": {
          "$ref": "#/$defs/selector"
        },
        "slot.head": {
          "$ref": "#/$defs/selector"
        },
        "slot.body": {
          "$ref": "#/$defs/selector"
        },
        "slot.hands": {
          "$ref": "#/$defs/selector"
        },
        "slot.feet": {
          "$ref": "#/$defs/selector"
        },
        "slot.neck": {
          "$ref": "#/$defs/selector"
        },
        "slot.ring": {
          "$ref": "#/$defs/selector"
        }
      }
    },
    "conditions": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
      }
    },
    "objective": {
      "enum": [
        "damage",
        "defense",
        "procs"
      ]
    },
    "base_stats": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stat.offense.power",
        "stat.critical.chance",
        "stat.critical.multiplier",
        "stat.defense.armor"
      ],
      "properties": {
        "stat.offense.power": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000
        },
        "stat.critical.chance": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.95
        },
        "stat.critical.multiplier": {
          "type": "number",
          "minimum": 1,
          "maximum": 1000000
        },
        "stat.defense.armor": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000
        }
      }
    }
  },
  "$defs": {
    "selector": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "uid"
          ],
          "properties": {
            "uid": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "bases",
            "affixes",
            "rarities"
          ],
          "properties": {
            "bases": {
              "type": "array",
              "uniqueItems": true,
              "maxItems": 128,
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
              }
            },
            "affixes": {
              "type": "array",
              "uniqueItems": true,
              "maxItems": 128,
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
              }
            },
            "rarities": {
              "type": "array",
              "uniqueItems": true,
              "maxItems": 128,
              "items": {
                "enum": [
                  "white",
                  "blue",
                  "gold",
                  "green",
                  "purple",
                  "red",
                  "set"
                ]
              }
            }
          }
        }
      ]
    }
  }
}
